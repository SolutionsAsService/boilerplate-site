{
  "name": "gauge-rafting",
  "version": "1.0.0",
  "private": true,
  "description": "A Next.js whitewater rafting site where the river level changes every rapid's class.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve.mjs",
    "check": "node --experimental-strip-types --no-warnings scripts/check.mjs",
    "verify": "next build && npm run check"
  },
  "dependencies": {
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "typescript": "5.7.2"
  }
}
